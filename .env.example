DASHBOARD_API_KEY=change-me
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:mini

# JSON map: camera id -> stream URL. Camera auth can also be embedded in the URL.
CAMERAS={"camera1":"http://192.0.0.4:8080/video","camera2":"http://192.0.0.5:8080/video"}
CAMERA_AUTH_JSON={}

# Use HOST_OS=Windows when Docker runs from Windows/WSL2 and local host camera URLs need host.docker.internal.
HOST_OS=auto
WSL_USE_HOST_DOCKER_INTERNAL=true

AI_ENABLED=true
OBJECT_DETECTION_ENABLED=true
OBJECT_DETECTION_BACKEND=auto
OBJECT_CONFIDENCE_THRESHOLD=0.45
PERSON_NMS_THRESHOLD=0.35
PERSON_BOX_PADDING=0.08
PERSON_MAX_AREA_RATIO=0.85
PERSON_ROTATION_DETECTION=true
AI_MAX_WORDS=22
AI_RETRIES=3
AI_MIN_INTERVAL_SECONDS=0
AI_ERROR_BACKOFF_SECONDS=120
PROCESS_EVERY_N_FRAMES=30
TARGET_FPS=8
FRAME_QUEUE_SIZE=2
LOG_LEVEL=INFO
