DASHBOARD_API_KEY=change-me
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JSON map: camera id -> stream URL. Camera auth can also be embedded in the URL.
CAMERAS={"camera1":"http://192.0.0.4:8080/video","camera2":"http://192.0.0.5:8080/video"}
CAMERA_AUTH_JSON={}

# Use HOST_OS=Windows when Docker runs from Windows/WSL2 and local host camera URLs need host.docker.internal.
HOST_OS=auto
WSL_USE_HOST_DOCKER_INTERNAL=true

AI_ENABLED=true
PROCESS_EVERY_N_FRAMES=30
TARGET_FPS=8
FRAME_QUEUE_SIZE=2
LOG_LEVEL=INFO
